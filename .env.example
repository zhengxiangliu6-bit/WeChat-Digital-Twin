# OpenAI-compatible API configuration
# Copy this file to .env and fill in your values.

# API endpoint (OpenAI, DeepSeek, or any compatible service)
OPENAI_BASE_URL=https://api.openai.com/v1

# Your API key (DO NOT commit this to git)
OPENAI_API_KEY=sk-your-key-here

# Model name
OPENAI_MODEL=gpt-4o-mini

# Max output tokens per reply (default: 1024)
# For reasoning models, this budget is shared between reasoning and content.
MAX_TOKENS=1024

# Reasoning effort for thinking models like GLM-5.3, DeepSeek-R1 (default: low)
# Options: low (no reasoning tokens), high, max
# Set to "off" to disable sending this parameter.
REASONING_EFFORT=low
